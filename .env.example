# ==========================================
# AURORA LEDGER - ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values.
# Never commit .env to version control.
# ==========================================

# MongoDB Atlas connection string
# Recommended: add ?retryWrites=true&w=majority&appName=aurora-ledger
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=aurora-ledger"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# Production URL (required for OAuth redirect URIs)
NEXTAUTH_URL="https://your-app.vercel.app"

# Optional Google OAuth Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
